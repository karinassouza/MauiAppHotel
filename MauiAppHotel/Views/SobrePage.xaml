<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.SobrePage"
             Title="Sobre o Desenvolvedor"
             BackgroundColor="#F5F5F5">

    <VerticalStackLayout Padding="30" Spacing="16" VerticalOptions="Center">

        <!-- Logótipo Fictício da Empresa -->
        <VerticalStackLayout Spacing="2" HorizontalOptions="Center" Margin="0,0,0,10">
            <Label Text="KS SOUZA"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#2C3E50" />
            <Label Text="H O T E L"
                   FontSize="14"
                   CharacterSpacing="6"
                   HorizontalOptions="Center"
                   TextColor="#7F8C8D" />
        </VerticalStackLayout>

        <Label Text="App Hotel - .NET MAUI"
               FontSize="20"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#2C3E50" />

        <Label Text="Projeto desenvolvido para a matéria do curso técnico de Desenvolvimento de Sistemas."
               FontSize="14"
               HorizontalTextAlignment="Center"
               TextColor="#7F8C8D" />

        <BoxView HeightRequest="1" BackgroundColor="#BDC3C7" Margin="0,5,0,5"/>

        <VerticalStackLayout Spacing="6">
            <Label Text="Desenvolvido por: Karina Santos de Souza"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#34495E" />

            <Label Text="Instituição: ETEC"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="#7F8C8D" />

            <Label Text="Tecnologia: .NET MAUI (C# / XAML)"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="#7F8C8D" />

            <Label Text="Ano de Desenvolvimento: 2026"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="#7F8C8D" />
        </VerticalStackLayout>

        <Button Text="Voltar"
                Clicked="BtnVoltar_Clicked"
                Margin="0,15,0,0" />
    </VerticalStackLayout>
</ContentPage>